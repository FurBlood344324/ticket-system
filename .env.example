# Azure Deployment — Değişken Tanımları
# Bu dosyayı .env olarak kopyala ve değerleri doldur:
#   cp .env.example .env
#
# .env dosyası .gitignore'da var, commit'lenmez.

# Azure bölgesi (student aboneliklerde west europe genelde kapalı)
LOCATION="austriaeast"

# Kaynak isimleri
RESOURCE_GROUP="ticket-system-rg"
APP_PLAN="ticket-plan"
APP_NAME="ticket-system-app"

# PostgreSQL
DB_SERVER="ticket-db"
DB_HOST="${DB_SERVER}.postgres.database.azure.com"
DB_NAME="ticket_support"
DB_USER="ticket_user"
# Güçlü bir şifre belirle — büyük/küçük harf, rakam, özel karakter içermeli
DB_PASSWORD="<BU-KISMI-DEGISTIR>"

# Güvenlik
# UUID oluşturmak için terminalde: uuidgen
PEPPER="<UUID-BURAYA>"

# GitHub (OIDC için)
GITHUB_ORG="FurBlood344324"
GITHUB_REPO="ticket-system"

# Azure App Registration (OIDC) — önce boş bırak, 3. adımda dolduracaksın
AZURE_CLIENT_ID=""
AZURE_TENANT_ID=""
AZURE_SUBSCRIPTION_ID=""
