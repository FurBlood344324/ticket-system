@model SupportTicket

@{
    ViewData["Title"] = "Talep Detayı";
    var replyModel = ViewBag.ReplyModel as TicketReplyViewModel ?? new TicketReplyViewModel { Status = Model.Status };
}

@functions {
    private static string StatusText(TicketStatus status) => status switch
    {
        TicketStatus.Open => "Açık",
        TicketStatus.Solved => "Çözüldü",
        TicketStatus.Closed => "Kapandı",
        TicketStatus.InProgress => "İşlemde",
        TicketStatus.WaitingCustomer => "Müşteri Bekleniyor",
        TicketStatus.Cancelled => "İptal",
        _ => status.ToString()
    };

    private static string StatusClass(TicketStatus status) => status switch
    {
        TicketStatus.Open => "text-bg-warning",
        TicketStatus.Solved => "text-bg-success",
        TicketStatus.Closed => "text-bg-secondary",
        TicketStatus.InProgress => "text-bg-info",
        TicketStatus.WaitingCustomer => "text-bg-primary",
        TicketStatus.Cancelled => "text-bg-dark",
        _ => "text-bg-light"
    };
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="h3 mb-2">@Model.Title</h1>
        <div class="text-muted">
            @Model.CustomerName tarafından @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm") tarihinde oluşturuldu.
        </div>
    </div>
    <span class="badge @StatusClass(Model.Status) fs-6">@StatusText(Model.Status)</span>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header fw-semibold">Talep açıklaması</div>
            <div class="card-body">
                <p class="mb-0 white-space-pre-line">@Model.Description</p>
            </div>
        </div>

        <h2 class="h5 mb-3">Cevaplar</h2>
        @if (Model.Replies.Count == 0)
        {
            <div class="alert alert-info">Henüz cevap yazılmadı.</div>
        }
        else
        {
            foreach (var reply in Model.Replies.OrderBy(reply => reply.CreatedAt))
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between gap-3">
                            <strong>@reply.AuthorName</strong>
                            <span class="text-muted small">@reply.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                        <div class="text-muted small mb-2">@reply.AuthorRole</div>
                        <p class="mb-0">@reply.Message</p>
                    </div>
                </div>
            }
        }
    </div>

    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header fw-semibold">Talep bilgileri</div>
            <div class="card-body">
                <dl class="mb-0">
                    <dt>Destek sorumlusu</dt>
                    <dd>@(Model.AssignedSupportName ?? "Atanmadı")</dd>
                    <dt>Durum</dt>
                    <dd>@StatusText(Model.Status)</dd>
                    <dt>Öncelik</dt>
                    <dd>@Model.Priority</dd>
                    <dt>Kategori</dt>
                    <dd>@Model.Category</dd>
                    <dt>Son güncelleme</dt>
                    <dd>@Model.LastUpdatedAt.ToString("dd.MM.yyyy HH:mm")</dd>
                </dl>

                @if (User.IsInRole("Support") && Model.AssignedSupportId is null)
                {
                    <form asp-action="Assign" asp-route-id="@Model.Id" method="post" class="mt-3">
                        <button type="submit" class="btn btn-outline-primary w-100">Talebi üstlen</button>
                    </form>
                }
            </div>
        </div>

        @if (Model.Status != TicketStatus.Closed || User.IsInRole("Support"))
        {
            <div class="card">
                <div class="card-header fw-semibold">Cevap yaz</div>
                <div class="card-body">
                    <form asp-action="Reply" asp-route-id="@Model.Id" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label for="Message" class="form-label">Mesaj</label>
                            <textarea id="Message" name="Message" rows="5" class="form-control">@replyModel.Message</textarea>
                        </div>

                        @if (User.IsInRole("Support"))
                        {
                            <div class="mb-3">
                                <label for="Status" class="form-label">Yeni durum</label>
                                <select id="Status" name="Status" class="form-select">
                                    @foreach (var status in Enum.GetValues<TicketStatus>())
                                    {
                                        <option value="@status" selected="@(replyModel.Status == status)">@StatusText(status)</option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" name="Status" value="Open" />
                        }

                        <button type="submit" class="btn btn-primary w-100">Cevabı kaydet</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
