@model List<KnowledgeCategory>
@{
    ViewData["Title"] = "Bilgi Bankası";
    var totalArticles = Model.Sum(c => c.Articles.Count);
}

<div class="cd-page-head">
    <span class="cd-eyebrow">Bilgi Bankası</span>
    <h1>Bilgi Bankası</h1>
    <p>@Model.Count kategori · @totalArticles yayınlanmış makale</p>
</div>

@if (Model.Count == 0)
{
    <div class="cd-card"><div class="cd-card-body"><div class="cd-empty">henüz kategori yok</div></div></div>
}
else
{
    <div class="cd-kb-grid">
        @foreach (var category in Model)
        {
            <a class="cd-kb-card" asp-action="Category" asp-route-id="@category.Id">
                <span class="cd-kb-icon">
                    <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M1 2.828c.885-.37 2.154-.769 3.388-.893 1.33-.134 2.458.063 3.112.752v9.746c-.935-.53-2.12-.603-3.213-.493-1.18.12-2.37.461-3.287.811V2.828Zm7.5-.141c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492V2.687Z"/></svg>
                </span>
                <h3>@category.Name</h3>
                <p>@(string.IsNullOrWhiteSpace(category.Description) ? "—" : category.Description)</p>
                <div class="mt-3"><span class="cd-pill cyan">@category.Articles.Count makale</span></div>
            </a>
        }
    </div>
}
