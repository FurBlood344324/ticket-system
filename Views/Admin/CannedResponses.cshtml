@model List<CannedResponse>
@{
    ViewData["Title"] = "Hazır Yanıtlar";
}

<div class="cd-page-head">
    <span class="cd-eyebrow">Yönetim · Hazır Yanıtlar</span>
    <h1>Hazır Yanıtlar</h1>
</div>
<partial name="_AdminNav" />

<div class="cd-toolbar">
    <span class="cd-pill cyan">@Model.Count kayıt</span>
    <span class="cd-spacer"></span>
    <a class="cd-btn cd-btn-primary" asp-action="CannedCreate">+ Yeni Hazır Yanıt</a>
</div>

<div class="cd-table-wrap">
    <table class="cd-table">
        <thead>
            <tr><th>#</th><th>Başlık</th><th>Kategori</th><th>Paylaşım</th><th>Kullanım</th><th></th></tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="6"><div class="cd-empty">kayıt yok</div></td></tr>
            }
            @foreach (var r in Model)
            {
                <tr>
                    <td class="cd-id">@r.Id</td>
                    <td>@r.Title</td>
                    <td><span class="cd-pill">@r.Category</span></td>
                    <td>@(r.IsShared ? "Ekip" : "Kişisel")</td>
                    <td class="fw-mono">@r.UsageCount</td>
                    <td><a class="cd-btn cd-btn-sm" asp-action="CannedEdit" asp-route-id="@r.Id">Düzenle</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
