@model List<KnowledgeArticle>
@{
    ViewData["Title"] = "KB Makaleleri";
}

<div class="cd-page-head">
    <span class="cd-eyebrow">Yönetim · Bilgi Bankası · Makaleler</span>
    <h1>Bilgi Bankası Makaleleri</h1>
</div>
<partial name="_AdminNav" />

<div class="cd-toolbar">
    <span class="cd-pill cyan">@Model.Count kayıt</span>
    <span class="cd-spacer"></span>
    <a class="cd-btn" asp-controller="Knowledge" asp-action="Index" target="_blank">↗ Genel görünüm</a>
    <a class="cd-btn cd-btn-primary" asp-action="ArticleCreate">+ Yeni Makale</a>
</div>

<div class="cd-table-wrap">
    <table class="cd-table">
        <thead>
            <tr><th>#</th><th>Başlık</th><th>Kategori</th><th>Görüntülenme</th><th>Durum</th><th>Güncelleme</th><th></th></tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="7"><div class="cd-empty">kayıt yok</div></td></tr>
            }
            @foreach (var a in Model)
            {
                <tr>
                    <td class="cd-id">@a.Id</td>
                    <td>@a.Title<div class="cd-id fw-mono" style="font-size:0.72rem;">/@a.Slug</div></td>
                    <td>@(a.Category?.Name ?? "—")</td>
                    <td class="fw-mono">@a.ViewCount</td>
                    <td>
                        @if (a.IsPublished)
                        {
                            <span class="cd-pill green"><span class="cd-dot"></span> yayında</span>
                        }
                        else
                        {
                            <span class="cd-pill warn"><span class="cd-dot warn"></span> taslak</span>
                        }
                    </td>
                    <td class="fw-mono">@a.UpdatedAt.ToLocalString("dd.MM.yyyy")</td>
                    <td><a class="cd-btn cd-btn-sm" asp-action="ArticleEdit" asp-route-id="@a.Id">Düzenle</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
