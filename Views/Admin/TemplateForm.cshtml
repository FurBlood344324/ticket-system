@model TicketTemplateFormViewModel
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Şablon Düzenle" : "Yeni Şablon";
    var departments = ViewBag.Departments as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<div class="cd-page-head">
    <span class="cd-eyebrow">Yönetim · Şablonlar · @(isEdit ? "Düzenle" : "Yeni")</span>
    <h1>@(isEdit ? "Şablon Düzenle" : "Yeni Şablon")</h1>
</div>

<div class="cd-card" style="max-width:820px;">
    <div class="cd-card-body">
        <form asp-action="@(isEdit ? "TemplateEdit" : "TemplateCreate")" method="post" class="cd-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="cd-field">
                <label asp-for="Title"></label>
                <input asp-for="Title" class="cd-input" />
                <span asp-validation-for="Title"></span>
            </div>
            <div class="cd-field">
                <label asp-for="Description"></label>
                <input asp-for="Description" class="cd-input" />
            </div>
            <div class="cd-form-grid">
                <div class="cd-field">
                    <label asp-for="Category"></label>
                    <select asp-for="Category" asp-items="Html.GetEnumSelectList<TicketCategory>()" class="cd-input"></select>
                </div>
                <div class="cd-field">
                    <label asp-for="Priority"></label>
                    <select asp-for="Priority" asp-items="Html.GetEnumSelectList<TicketPriority>()" class="cd-input"></select>
                </div>
                <div class="cd-field cd-col-span-2">
                    <label asp-for="DepartmentId"></label>
                    <select asp-for="DepartmentId" asp-items="departments" class="cd-input">
                        <option value="">— Departman yok —</option>
                    </select>
                </div>
            </div>
            <div class="cd-field">
                <label asp-for="Content"></label>
                <textarea asp-for="Content" class="cd-input"></textarea>
                <span asp-validation-for="Content"></span>
            </div>
            <div class="cd-field">
                <label class="cd-check"><input asp-for="IsActive" type="checkbox" /> Aktif</label>
            </div>
            <div class="cd-toolbar mt-2">
                <button type="submit" class="cd-btn cd-btn-primary">Kaydet</button>
                <a class="cd-btn cd-btn-ghost" asp-action="Templates">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
