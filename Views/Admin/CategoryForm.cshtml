@model KnowledgeCategoryFormViewModel
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Kategori Düzenle" : "Yeni Kategori";
}

<div class="cd-page-head">
    <span class="cd-eyebrow">Yönetim · Bilgi Bankası · Kategoriler · @(isEdit ? "Düzenle" : "Yeni")</span>
    <h1>@(isEdit ? "Kategori Düzenle" : "Yeni Kategori")</h1>
</div>

<div class="cd-card" style="max-width:640px;">
    <div class="cd-card-body">
        <form asp-action="@(isEdit ? "CategoryEdit" : "CategoryCreate")" method="post" class="cd-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="cd-field">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="cd-input" />
                <span asp-validation-for="Name"></span>
            </div>
            <div class="cd-field">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="cd-input" style="min-height:90px;"></textarea>
            </div>
            <div class="cd-form-grid">
                <div class="cd-field">
                    <label asp-for="SortOrder"></label>
                    <input asp-for="SortOrder" type="number" class="cd-input" />
                </div>
                <div class="cd-field d-flex align-items-end">
                    <label class="cd-check"><input asp-for="IsActive" type="checkbox" /> Aktif</label>
                </div>
            </div>
            <div class="cd-toolbar mt-2">
                <button type="submit" class="cd-btn cd-btn-primary">Kaydet</button>
                <a class="cd-btn cd-btn-ghost" asp-action="Categories">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
