@model TagFormViewModel
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Etiket Düzenle" : "Yeni Etiket";
}

<div class="cd-page-head">
    <span class="cd-eyebrow">Yönetim · Etiketler · @(isEdit ? "Düzenle" : "Yeni")</span>
    <h1>@(isEdit ? "Etiket Düzenle" : "Yeni Etiket")</h1>
</div>

<div class="cd-card" style="max-width:520px;">
    <div class="cd-card-body">
        <form asp-action="@(isEdit ? "TagEdit" : "TagCreate")" method="post" class="cd-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="cd-field">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="cd-input" />
                <span asp-validation-for="Name"></span>
            </div>
            <div class="cd-field">
                <label asp-for="Color"></label>
                <div class="d-flex gap-2 align-items-center">
                    <input type="color" id="color-picker" value="@(Model.Color?.StartsWith("#") == true ? Model.Color : "#3ad6e6")" class="cd-input" style="width:60px;padding:0.2rem;height:42px;" />
                    <input asp-for="Color" id="color-text" class="cd-input fw-mono" />
                </div>
                <span asp-validation-for="Color"></span>
            </div>
            <div class="cd-toolbar mt-2">
                <button type="submit" class="cd-btn cd-btn-primary">Kaydet</button>
                <a class="cd-btn cd-btn-ghost" asp-action="Tags">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var picker = document.getElementById('color-picker');
            var text = document.getElementById('color-text');
            if (picker && text) {
                picker.addEventListener('input', function () { text.value = picker.value; });
                text.addEventListener('input', function () {
                    if (/^#[0-9a-fA-F]{6}$/.test(text.value)) { picker.value = text.value; }
                });
            }
        })();
    </script>
}
