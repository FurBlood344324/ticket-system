@model List<TicketTag>
@{
    ViewData["Title"] = "Etiketler";
}

<div class="cd-page-head">
    <span class="cd-eyebrow">Yönetim · Etiketler</span>
    <h1>Etiketler</h1>
</div>
<partial name="_AdminNav" />

<div class="cd-toolbar">
    <span class="cd-pill cyan">@Model.Count kayıt</span>
    <span class="cd-spacer"></span>
    <a class="cd-btn cd-btn-primary" asp-action="TagCreate">+ Yeni Etiket</a>
</div>

<div class="cd-table-wrap">
    <table class="cd-table">
        <thead>
            <tr><th>#</th><th>Önizleme</th><th>Ad</th><th>Renk</th><th></th></tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="5"><div class="cd-empty">kayıt yok</div></td></tr>
            }
            @foreach (var t in Model)
            {
                <tr>
                    <td class="cd-id">@t.Id</td>
                    <td><span class="cd-pill" style="border-color:@t.Color;color:@t.Color;"><span class="cd-dot" style="background:@t.Color;box-shadow:0 0 8px @t.Color;"></span> @t.Name</span></td>
                    <td>@t.Name</td>
                    <td class="fw-mono">@t.Color</td>
                    <td><a class="cd-btn cd-btn-sm" asp-action="TagEdit" asp-route-id="@t.Id">Düzenle</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
