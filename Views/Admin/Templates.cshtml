@model List<TicketTemplate>
@{
    ViewData["Title"] = "Şablonlar";
}

<div class="cd-page-head">
    <span class="cd-eyebrow">Yönetim · Şablonlar</span>
    <h1>Talep Şablonları</h1>
</div>
<partial name="_AdminNav" />

<div class="cd-toolbar">
    <span class="cd-pill cyan">@Model.Count kayıt</span>
    <span class="cd-spacer"></span>
    <a class="cd-btn cd-btn-primary" asp-action="TemplateCreate">+ Yeni Şablon</a>
</div>

<div class="cd-table-wrap">
    <table class="cd-table">
        <thead>
            <tr><th>#</th><th>Başlık</th><th>Kategori</th><th>Öncelik</th><th>Departman</th><th>Kullanım</th><th>Durum</th><th></th></tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="8"><div class="cd-empty">kayıt yok</div></td></tr>
            }
            @foreach (var t in Model)
            {
                <tr>
                    <td class="cd-id">@t.Id</td>
                    <td>@t.Title</td>
                    <td>@DisplayLabels.Category(t.Category)</td>
                    <td><span class="cd-pill @DisplayLabels.PriorityClass(t.Priority)">@DisplayLabels.Priority(t.Priority)</span></td>
                    <td>@(t.Department?.Name ?? "—")</td>
                    <td class="fw-mono">@t.UsageCount</td>
                    <td>
                        @if (t.IsActive)
                        {
                            <span class="cd-pill green"><span class="cd-dot"></span> aktif</span>
                        }
                        else
                        {
                            <span class="cd-pill off"><span class="cd-dot off"></span> pasif</span>
                        }
                    </td>
                    <td><a class="cd-btn cd-btn-sm" asp-action="TemplateEdit" asp-route-id="@t.Id">Düzenle</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
