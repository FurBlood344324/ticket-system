@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Şifre Değiştir";
}

<div class="cd-page-head">
    <span class="cd-eyebrow">Hesap · Güvenlik</span>
    <h1>Şifre Değiştir</h1>
    <p>Hesabınızın parolasını güncelleyin.</p>
</div>

<div class="cd-card" style="max-width:520px;">
    <div class="cd-card-body">
        <form asp-action="ChangePassword" method="post" class="cd-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="cd-field">
                <label asp-for="CurrentPassword"></label>
                <input asp-for="CurrentPassword" class="cd-input" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword"></span>
            </div>
            <div class="cd-field">
                <label asp-for="NewPassword"></label>
                <input asp-for="NewPassword" class="cd-input" autocomplete="new-password" />
                <span asp-validation-for="NewPassword"></span>
            </div>
            <div class="cd-field">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="cd-input" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>
            <div class="cd-toolbar mt-2">
                <button type="submit" class="cd-btn cd-btn-primary">Şifreyi Güncelle</button>
                <a class="cd-btn cd-btn-ghost" asp-controller="Dashboard" asp-action="Index">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
