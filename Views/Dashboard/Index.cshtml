@model TicketSupport.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="dash-shell">
    <!-- Greeting -->
    <div class="dash-greeting">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <h1 class="mb-0">Merhaba, @Model.UserName 👋</h1>
            @{
                var roleCss = Model.UserRole switch
                {
                    "Admin" => "admin",
                    "Support" => "support",
                    _ => "customer"
                };
                var roleLabel = Model.UserRole switch
                {
                    "Admin" => "Yönetici",
                    "Support" => "Destek",
                    _ => "Müşteri"
                };
            }
            <span class="dash-role-badge @roleCss">@roleLabel</span>
        </div>
        <p class="text-muted mt-1 mb-0">Destek sistemi özet durumu</p>
    </div>

    <!-- Stat Cards -->
    <div class="dash-section-title">Genel Bakış</div>
    <div class="row g-3 mb-4">
        <!-- Açık Talepler -->
        <div class="col-6 col-md-4 col-xl-2">
            <div class="dash-stat-card">
                <div class="dash-stat-icon blue">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 00-1.883 2.542l.857 6a2.25 2.25 0 002.227 1.932H19.05a2.25 2.25 0 002.227-1.932l.857-6a2.25 2.25 0 00-1.883-2.542m-16.5 0V6A2.25 2.25 0 016 3.75h3.879a1.5 1.5 0 011.06.44l2.122 2.12a1.5 1.5 0 001.06.44H18A2.25 2.25 0 0120.25 9v.776" />
                    </svg>
                </div>
                <div class="dash-stat-value">@Model.OpenCount</div>
                <div class="dash-stat-label">Açık Talepler</div>
                <svg class="dash-stat-bg" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" style="color:#3b82f6">
                    <path d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 00-1.883 2.542l.857 6a2.25 2.25 0 002.227 1.932H19.05a2.25 2.25 0 002.227-1.932l.857-6a2.25 2.25 0 00-1.883-2.542m-16.5 0V6A2.25 2.25 0 016 3.75h3.879a1.5 1.5 0 011.06.44l2.122 2.12a1.5 1.5 0 001.06.44H18A2.25 2.25 0 0120.25 9v.776"/>
                </svg>
            </div>
        </div>

        <!-- Devam Eden -->
        <div class="col-6 col-md-4 col-xl-2">
            <div class="dash-stat-card">
                <div class="dash-stat-icon orange">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182" />
                    </svg>
                </div>
                <div class="dash-stat-value">@Model.InProgressCount</div>
                <div class="dash-stat-label">Devam Eden</div>
                <svg class="dash-stat-bg" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" style="color:#f59e0b">
                    <path d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182"/>
                </svg>
            </div>
        </div>

        <!-- Çözülen -->
        <div class="col-6 col-md-4 col-xl-2">
            <div class="dash-stat-card">
                <div class="dash-stat-icon green">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div class="dash-stat-value">@Model.SolvedCount</div>
                <div class="dash-stat-label">Çözülen</div>
                <svg class="dash-stat-bg" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" style="color:#10b981">
                    <path d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
        </div>

        <!-- SLA İhlali -->
        <div class="col-6 col-md-4 col-xl-2">
            <div class="dash-stat-card @(Model.SlaBreachCount > 0 ? "sla-alert" : "")">
                <div class="dash-stat-icon red">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                    </svg>
                </div>
                <div class="dash-stat-value">@Model.SlaBreachCount</div>
                <div class="dash-stat-label">SLA İhlali</div>
                <svg class="dash-stat-bg" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" style="color:#ef4444">
                    <path d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
                </svg>
            </div>
        </div>

        <!-- Bugün Çözülen -->
        <div class="col-6 col-md-4 col-xl-2">
            <div class="dash-stat-card">
                <div class="dash-stat-icon teal">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5m-9-6h.008v.008H12v-.008zM12 15h.008v.008H12V15zm0 2.25h.008v.008H12v-.008zM9.75 15h.008v.008H9.75V15zm0 2.25h.008v.008H9.75v-.008zM7.5 15h.008v.008H7.5V15zm0 2.25h.008v.008H7.5v-.008zm6.75-4.5h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V15zm0 2.25h.008v.008h-.008v-.008zm2.25-4.5h.008v.008H16.5v-.008zm0 2.25h.008v.008H16.5V15z" />
                    </svg>
                </div>
                <div class="dash-stat-value">@Model.TodayResolvedCount</div>
                <div class="dash-stat-label">Bugün Çözülen</div>
                <svg class="dash-stat-bg" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" style="color:#0d9488">
                    <path d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
                </svg>
            </div>
        </div>

        <!-- Atanmamış (Admin/Support only) -->
        @if (Model.UserRole == "Admin" || Model.UserRole == "Support")
        {
            <div class="col-6 col-md-4 col-xl-2">
                <div class="dash-stat-card">
                    <div class="dash-stat-icon purple">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                        </svg>
                    </div>
                    <div class="dash-stat-value">@Model.UnassignedCount</div>
                    <div class="dash-stat-label">Atanmamış</div>
                    <svg class="dash-stat-bg" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" style="color:#7c3aed">
                        <path d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
                    </svg>
                </div>
            </div>
        }
    </div>

    <!-- Charts Row -->
    <div class="dash-section-title">İstatistikler</div>
    <div class="row g-3 mb-4">
        <!-- Category Distribution -->
        <div class="col-md-6">
            <div class="dash-chart-card">
                <div class="dash-chart-title">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width:18px;height:18px;vertical-align:text-bottom;margin-right:6px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
                    </svg>
                    Kategori Dağılımı
                </div>
                <div class="dash-chart-wrapper">
                    <canvas id="categoryChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Priority Distribution -->
        <div class="col-md-6">
            <div class="dash-chart-card">
                <div class="dash-chart-title">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width:18px;height:18px;vertical-align:text-bottom;margin-right:6px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 107.5 7.5h-7.5V6z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0013.5 3v7.5z" />
                    </svg>
                    Öncelik Dağılımı
                </div>
                <div class="dash-chart-wrapper">
                    <canvas id="priorityChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Trend Chart -->
    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="dash-chart-card">
                <div class="dash-chart-title">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width:18px;height:18px;vertical-align:text-bottom;margin-right:6px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.281m5.94 2.28l-2.28 5.941" />
                    </svg>
                    Son 7 Gün Talep Trendi
                </div>
                <div class="dash-chart-wrapper trend">
                    <canvas id="trendChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- SLA Breach Table -->
    @if (Model.SlaBreachCount > 0 && Model.SlaBreachTickets != null && Model.SlaBreachTickets.Any())
    {
        <div class="dash-section-title">SLA İhlalleri</div>
        <div class="dash-sla-table mb-4">
            <div class="dash-sla-header">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                </svg>
                SLA Süresi Aşılan Talepler
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Başlık</th>
                            <th>Müşteri</th>
                            <th>Atanan</th>
                            <th>Öncelik</th>
                            <th>Son Tarih</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.SlaBreachTickets)
                        {
                            <tr>
                                <td>
                                    <a href="/Tickets/Details/@item.TicketId" class="fw-semibold text-decoration-none">#@item.TicketId</a>
                                </td>
                                <td>
                                    <a href="/Tickets/Details/@item.TicketId" class="text-decoration-none text-dark fw-medium">@item.Title</a>
                                </td>
                                <td class="text-muted">@item.CustomerName</td>
                                <td class="text-muted">@(item.AssignedTo ?? "—")</td>
                                <td>
                                    @{
                                        var priClass = item.Priority switch
                                        {
                                            "Low" => "bg-success",
                                            "Medium" => "bg-info",
                                            "High" => "bg-warning text-dark",
                                            "Critical" => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                        var priLabel = item.Priority switch
                                        {
                                            "Low" => "Düşük",
                                            "Medium" => "Orta",
                                            "High" => "Yüksek",
                                            "Critical" => "Kritik",
                                            _ => item.Priority
                                        };
                                    }
                                    <span class="badge @priClass">@priLabel</span>
                                </td>
                                <td>
                                    <span class="text-danger fw-semibold">@(item.DueDate?.ToString("dd MMM yyyy HH:mm") ?? "—")</span>
                                </td>
                                <td>
                                    @{
                                        var statusClass = item.Status switch
                                        {
                                            "Open" => "bg-primary",
                                            "InProgress" => "bg-warning text-dark",
                                            "Solved" => "bg-success",
                                            "Closed" => "bg-secondary",
                                            "WaitingCustomer" => "bg-info",
                                            "Cancelled" => "bg-dark",
                                            _ => "bg-secondary"
                                        };
                                        var statusLabel = item.Status switch
                                        {
                                            "Open" => "Açık",
                                            "InProgress" => "Devam Ediyor",
                                            "Solved" => "Çözüldü",
                                            "Closed" => "Kapatıldı",
                                            "WaitingCustomer" => "Müşteri Bekleniyor",
                                            "Cancelled" => "İptal",
                                            _ => item.Status
                                        };
                                    }
                                    <span class="badge @statusClass">@statusLabel</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Recent Updates -->
    @if (Model.RecentUpdates != null && Model.RecentUpdates.Any())
    {
        <div class="dash-section-title">Son Güncellemeler</div>
        <div class="dash-recent-card">
            <div class="dash-recent-header">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width:20px;height:20px;">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Son Aktiviteler
            </div>
            @foreach (var update in Model.RecentUpdates)
            {
                <div class="dash-recent-item">
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <a href="/Tickets/Details/@update.TicketId" class="dash-recent-title">
                                #@update.TicketId — @update.Title
                            </a>
                            @{
                                var uStatusClass = update.Status switch
                                {
                                    "Open" => "bg-primary",
                                    "InProgress" => "bg-warning text-dark",
                                    "Solved" => "bg-success",
                                    "Closed" => "bg-secondary",
                                    "WaitingCustomer" => "bg-info",
                                    "Cancelled" => "bg-dark",
                                    _ => "bg-secondary"
                                };
                                var uStatusLabel = update.Status switch
                                {
                                    "Open" => "Açık",
                                    "InProgress" => "Devam Ediyor",
                                    "Solved" => "Çözüldü",
                                    "Closed" => "Kapatıldı",
                                    "WaitingCustomer" => "Müşteri Bekleniyor",
                                    "Cancelled" => "İptal",
                                    _ => update.Status
                                };
                            }
                            <span class="badge @uStatusClass" style="font-size:0.7rem;">@uStatusLabel</span>
                        </div>
                        <div class="dash-recent-meta mt-1">
                            @update.UpdatedBy &middot;
                            @{
                                var timeAgo = DateTime.Now - update.UpdatedAt;
                                string agoText;
                                if (timeAgo.TotalMinutes < 1)
                                    agoText = "az önce";
                                else if (timeAgo.TotalMinutes < 60)
                                    agoText = $"{(int)timeAgo.TotalMinutes} dk önce";
                                else if (timeAgo.TotalHours < 24)
                                    agoText = $"{(int)timeAgo.TotalHours} saat önce";
                                else
                                    agoText = $"{(int)timeAgo.TotalDays} gün önce";
                            }
                            @agoText
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        window.dashboardData = {
            categoryLabels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryLabels)),
            categoryCounts: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryCounts)),
            priorityLabels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PriorityLabels)),
            priorityCounts: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PriorityCounts)),
            trendLabels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrendLabels)),
            trendCounts: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrendCounts))
        };
    </script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
