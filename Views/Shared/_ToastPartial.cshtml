<div id="toast-container" class="toast-container"></div>
<template id="toast-template">
    <div class="app-toast" role="status" aria-live="polite">
        <div class="app-toast__accent"></div>
        <div class="app-toast__body">
            <div class="app-toast__title"></div>
            <div class="app-toast__message"></div>
        </div>
        <button type="button" class="app-toast__close" aria-label="Kapat">x</button>
    </div>
</template>
