@using System.Security.Claims
@inject TicketSupport.Data.ApplicationDbContext DbContext
@{
    var currentUserIdText = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var hasUserId = int.TryParse(currentUserIdText, out var currentUserId);
    var unreadCount = User.Identity?.IsAuthenticated == true && hasUserId
        ? DbContext.UserNotifications.Count(item => item.UserId == currentUserId && !item.IsRead)
        : 0;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ticket Destek</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/toast.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TicketSupport.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div id="app-shell"
         data-is-authenticated="@(User.Identity?.IsAuthenticated == true ? "true" : "false")"
         data-unread-count="@unreadCount">
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container-fluid">
                    <a class="navbar-brand fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">Ticket Destek</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                            </li>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Tickets" asp-action="Index">Talepler</a>
                                </li>
                                @if (User.IsInRole("Customer"))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="Tickets" asp-action="Create">Yeni Talep</a>
                                    </li>
                                }
                                @if (User.IsInRole("Admin"))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="Admin" asp-action="Index">Yönetim</a>
                                    </li>
                                }
                            }
                        </ul>
                        <ul class="navbar-nav">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li class="nav-item me-2">
                                    <a class="nav-link position-relative px-2" asp-controller="Notifications" asp-action="Index" title="Bildirimler">
                                        <span class="d-inline-flex align-items-center gap-2">
                                            <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                                                <path d="M8 1a3 3 0 0 0-3 3v1.09c0 .71-.2 1.4-.58 2L3.35 8.9A1 1 0 0 0 4.2 10.5h7.6a1 1 0 0 0 .85-1.6l-1.07-1.81A3.98 3.98 0 0 1 11 5.09V4a3 3 0 0 0-3-3Zm0 14a2 2 0 0 0 1.93-1.5H6.07A2 2 0 0 0 8 15Z" />
                                            </svg>
                                            <span>Bildirimler</span>
                                        </span>
                                        <span id="notification-badge"
                                              class="notification-badge badge rounded-pill text-bg-danger @(unreadCount == 0 ? "d-none" : null)">
                                            @(unreadCount > 99 ? "99+" : unreadCount)
                                        </span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <span class="nav-link text-muted">@User.Identity.Name</span>
                                </li>
                                <li class="nav-item">
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="btn btn-link nav-link text-dark">Çıkış</button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Giriş</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Kayıt</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
        <div class="container">
            <main role="main" class="pb-3">
                @if (TempData["Message"] is string message)
                {
                    <div class="alert alert-success">@message</div>
                }
                @RenderBody()
            </main>
        </div>
        <partial name="_ToastPartial" />

        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2026 - Ticket Destek
            </div>
        </footer>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" integrity="sha512-/7Q6A8lPigZZI1NIsDPKySx1VHa4EraseFH8blYNx+a3Pl6xNcNehJIK/gB1LsY5cqK8QxSNaben7nuPhYu95w==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="~/js/signalr-client.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function() {
            @if (User.Identity?.IsAuthenticated == true)
            {
                <text>
                function updateNotificationBadge() {
                    fetch('/Notifications/GetUnreadCount')
                        .then(function(r) { return r.json(); })
                        .then(function(data) {
                            var badge = document.getElementById('notification-badge');
                            var count = data.unreadCount ?? data.count ?? 0;
                            if (badge) {
                                if (count > 0) {
                                    badge.textContent = count > 99 ? '99+' : count;
                                    badge.style.display = '';
                                    badge.classList.remove('d-none');
                                } else {
                                    badge.style.display = 'none';
                                    badge.classList.add('d-none');
                                }
                            }
                        })
                        .catch(function() { });
                }
                updateNotificationBadge();
                setInterval(updateNotificationBadge, 60000);
                </text>
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
