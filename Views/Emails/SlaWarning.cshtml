<!DOCTYPE html>
<html lang="tr">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /></head>
<body style="margin:0;padding:0;background-color:#f4f6f9;font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;">
<table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f6f9;padding:20px 0;"><tr><td align="center">
<table width="600" cellpadding="0" cellspacing="0" style="background-color:#ffffff;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.08);">
<tr><td style="background-color:#dc2626;padding:24px 30px;text-align:center;"><h1 style="color:#ffffff;font-size:22px;margin:0;">⚠️ SLA Uyarısı</h1></td></tr>
<tr><td style="padding:30px;">
<p style="color:#374151;font-size:15px;line-height:1.6;margin:0 0 16px;">Merhaba <strong>{{FullName}}</strong>,</p>
<p style="color:#dc2626;font-size:15px;line-height:1.6;margin:0 0 16px;font-weight:600;">Bir talep için SLA süresi aşıldı! Lütfen hemen aksiyon alın.</p>
<table width="100%" cellpadding="0" cellspacing="0" style="background-color:#fef2f2;border:1px solid #fecaca;border-radius:6px;margin-bottom:24px;">
<tr><td style="padding:16px 20px;">
<table width="100%" cellpadding="0" cellspacing="0">
<tr><td style="padding:6px 0;color:#991b1b;font-size:13px;width:120px;">Talep No:</td><td style="padding:6px 0;color:#7f1d1d;font-size:14px;font-weight:600;">#{{TicketId}}</td></tr>
<tr><td style="padding:6px 0;color:#991b1b;font-size:13px;">Başlık:</td><td style="padding:6px 0;color:#7f1d1d;font-size:14px;">{{TicketTitle}}</td></tr>
<tr><td style="padding:6px 0;color:#991b1b;font-size:13px;">Müşteri:</td><td style="padding:6px 0;color:#7f1d1d;font-size:14px;">{{CustomerName}}</td></tr>
<tr><td style="padding:6px 0;color:#991b1b;font-size:13px;">Öncelik:</td><td style="padding:6px 0;color:#7f1d1d;font-size:14px;">{{Priority}}</td></tr>
<tr><td style="padding:6px 0;color:#991b1b;font-size:13px;">Son Tarih:</td><td style="padding:6px 0;color:#7f1d1d;font-size:14px;">{{DueDate}}</td></tr>
</table>
</td></tr>
</table>
<div style="text-align:center;margin-bottom:24px;"><a href="{{TicketUrl}}" style="display:inline-block;background-color:#dc2626;color:#ffffff;text-decoration:none;padding:12px 32px;border-radius:6px;font-size:15px;font-weight:500;">Talebi Görüntüle</a></div>
</td></tr>
<tr><td style="background-color:#f9fafb;padding:16px 30px;text-align:center;border-top:1px solid #e5e7eb;"><p style="color:#9ca3af;font-size:12px;margin:0;">Bu email Ticket Destek Sistemi tarafından otomatik olarak gönderilmiştir.<br>&copy; {{CurrentYear}} Ticket Destek.</p></td></tr>
</table>
